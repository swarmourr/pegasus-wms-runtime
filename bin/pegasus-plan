#!/bin/sh
#
# pegasus-plan wrapper — delegates to the real pegasus-plan in PEGASUS_HOME,
# then injects runtime prediction prescripts into the generated submit dir.
#
# Works in two modes:
#   1. Zero-install: PEGASUS_HOME points to an extracted tarball
#   2. System install: falls back to the next pegasus-plan in PATH

# Find the real pegasus-plan — never call ourselves recursively
if [ -n "$PEGASUS_HOME" ] && [ -x "$PEGASUS_HOME/bin/pegasus-plan" ]; then
    _REAL="$PEGASUS_HOME/bin/pegasus-plan"
else
    # Fall back to next pegasus-plan in PATH (skip ourselves)
    _SELF="$(cd "$(dirname "$0")" && pwd)/pegasus-plan"
    _REAL="$(PATH=$(echo "$PATH" | tr ':' '\n' | grep -v "$(dirname "$_SELF")" | tr '\n' ':') which pegasus-plan 2>/dev/null)"
fi

if [ -z "$_REAL" ] || [ ! -x "$_REAL" ]; then
    echo "[pegasus-plan] ERROR: cannot find real pegasus-plan. Set PEGASUS_HOME." >&2
    exit 1
fi

# Run the real planner, capture output to detect submit dir
_tmpout=$(mktemp)
set +e
"$_REAL" "$@" > "$_tmpout" 2>&1
_rc=$?
set -e
cat "$_tmpout"
[ "$_rc" -eq 0 ] || { rm -f "$_tmpout"; exit "$_rc"; }

# Auto-detect submit dir from "pegasus-run /path/runNNNN" line in output
_run_dir=$(grep "pegasus-run" "$_tmpout" 2>/dev/null | awk '{print $NF}' | grep "run[0-9]" | grep -v "jdbc:" | grep -v "\." | head -1)
rm -f "$_tmpout"

# Inject runtime prediction prescripts
if [ -n "$_run_dir" ] && command -v pegasus-inject-prescripts >/dev/null 2>&1; then
    echo "[pegasus-plan] Injecting runtime prediction prescripts into $_run_dir"
    pegasus-inject-prescripts "$_run_dir" || true
fi
